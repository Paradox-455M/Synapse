{
  "manifest_version": 3,
  "name": "Synapse",
  "version": "1.0.0",
  "description": "Inject AI Brain Packs into ChatGPT, Claude, and Gemini to upgrade how they reason and respond.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-memory-prompt.js", "content-isolated.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-memory-prompt.js", "content-claude-isolated.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content-memory-prompt.js", "content-gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["content-memory-prompt.js", "content-perplexity-isolated.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Synapse"
  },
  "web_accessible_resources": [
    {
      "resources": ["content-main.js"],
      "matches": ["https://chatgpt.com/*"]
    },
    {
      "resources": ["content-claude-main.js"],
      "matches": ["https://claude.ai/*"]
    },
    {
      "resources": ["content-perplexity-main.js"],
      "matches": ["https://www.perplexity.ai/*"]
    },
    {
      "resources": ["popup/privacy.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
